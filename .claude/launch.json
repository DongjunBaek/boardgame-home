{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "backend"
      ],
      "port": 8000
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app-sandbox",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001,
      "env": {
        "BGH_DATA_DIR": "data-sandbox"
      }
    }
  ]
}